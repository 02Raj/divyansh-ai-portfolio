# Sarvam AI (optional if quick topics are seeded in Mongo)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b

# MongoDB — caches frequent quick-topic answers (about/skills/projects/…)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Vercel Cron auth for /api/cron/mongo-keepalive (Atlas stay-awake ping every 5 days)
CRON_SECRET=generate_a_long_random_string

# Set to true only if you want Quick Topics regenerated via Sarvam (uses credits)
# SARVAM_FOR_QUICK=false
